Algoritmo BinarioAOctal
	Definir binario, octal, grupo, potencia, digito Como Entero
	
	octal <- 0
	potencia <- 0
	
	Escribir "Ingresa un numero binario:"
	Leer binario
	
	Mientras binario > 0 Hacer
		grupo <- 0
		
		Para i <- 0 Hasta 2 Hacer
			digito <- binario MOD 10
			grupo <- grupo + digito * (2 ^ i)
			binario <- Trunc(binario / 10)
		FinPara
		
		octal <- octal + grupo * (10 ^ potencia)
		potencia <- potencia + 1
	FinMientras
	
	Escribir "El numero en octal es: ", octal
FinAlgoritmo